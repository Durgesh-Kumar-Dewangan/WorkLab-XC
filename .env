NEXT_PUBLIC_WLXC_API_LEADS=/leads
NEXT_PUBLIC_WLXC_API_AUTH=
NEXT_PUBLIC_WLXC_CURRENCY=₹

# ---------------------------------------------------------------------------------
# Core (required in production)
# ---------------------------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_SECRET=7HFv95qclbGIK7yJb3oMw5HxDVXvbyacYDaLzqWLZf3qhzDk_nU-hKuMAr9MDr_i
DATABASE_URL=postgresql://postgres.eviesoyhibblssardjei:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres              #   
CRON_SECRET=0iTgv0VeSzs_N8grQc6M8-IviFNRoK6trIoxvsjnhYFOEPq6Aq_4FM_cApwOOHPc
TRUST_PROXY=1              # read the client IP from cf-connecting-ip / x-forwarded-for
WORKER_MODE=inline
JOB_BUDGET_MS=100000       # time one invocation may spend on a run before handing back
QUOTA_TZ_OFFSET_MIN=330    # daily limits reset at midnight in this UTC offset (330 = IST)
FEEDBACK_GRACE_SESSIONS=0  # unrated sessions allowed before the feedback gate blocks a new one

# ---------------------------------------------------------------------------------
# Text AI. Tried in LLM_ORDER; if a provider errors, times out, is rate limited or returns
# invalid output, the next one is used, so a run never stalls on one service.
# Users never see which provider answered. Everything works with only the free ones below.
#
# PRIVACY: free tiers of Gemini, Mistral and OpenRouter may use prompts to improve their models.
# Put no-training providers (azure, openai) FIRST if users upload private material.
# ---------------------------------------------------------------------------------
LLM_ORDER=azure,openai,gemini,groq,mistral,openrouter,cloudflare,compat
# Every *_API_KEY also accepts *_API_KEYS=key1,key2,key3. Keys rotate, and a rate-limited key rests for a minute.
# Azure OpenAI (startup / Imagine Cup credits)
AZURE_OPENAI_ENDPOINT=     # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=   # the deployment name, e.g. gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=   # text-embedding-3-small deployment: lets the library recognise a topic worded differently (also works with OPENAI_API_KEY)
# OpenAI API (official, paid; this is the supported way to use GPT models in the product)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini API (free tier at aistudio.google.com/apikey). Same Google family as NotebookLM, via the official API.
GEMINI_API_KEY=AQ.Ab8RN6LyZvLzWhECELPA8Af2z8UDtGps1nd25KaeNMO5cgnhWw
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest
# Groq (free tier, runs Llama): console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Mistral (free "experiment" tier): console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# OpenRouter free Llama models: openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Cloudflare Workers AI (free tier). Also used for images.
CF_ACCOUNT_ID=
CF_API_TOKEN=              # token with "Workers AI" permission
CF_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Any other OpenAI-compatible endpoint (self-hosted Ollama / vLLM, Together, Fireworks ...) as a last resort
COMPAT_LLM_BASE_URL=
COMPAT_LLM_API_KEY=
COMPAT_LLM_MODEL=

# ---------------------------------------------------------------------------------
# Image AI. Free models tried in order until one returns a valid image.
# ---------------------------------------------------------------------------------
IMAGE_ORDER=cloudflare,huggingface,pollinations
CF_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/bytedance/stable-diffusion-xl-lightning
HF_TOKEN=
HF_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell
POLLINATIONS_ENABLED=1

# ---------------------------------------------------------------------------------
# Payments: Razorpay Payment Links. Prices are in rupees; 0 = not for sale.
# ---------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # set the same value in Razorpay → Webhooks; subscribe to payment_link.paid / .expired / .cancelled
PRICE_LEARNER_MONTH_INR=99
PRICE_LEARNER_YEAR_INR=799
PRICE_PLUS_MONTH_INR=179
PRICE_PLUS_YEAR_INR=1499
PRICE_CLASSROOM_MONTH_INR=0
PRICE_CLASSROOM_YEAR_INR=0

# ---------------------------------------------------------------------------------
# Email from the worklabxc.com domain. Set ANY ONE provider (more = automatic fallback, in MAIL_ORDER).
# DNS records (SPF, DKIM, DMARC) are in DEPLOY.md. With none set, emails are printed to the log in dev only.
# ---------------------------------------------------------------------------------
MAIL_DOMAIN=worklabxc.com
MAIL_FROM="WorkLab XC <hello@worklabxc.com>"
MAIL_NOREPLY="WorkLab XC <noreply@worklabxc.com>"
SUPPORT_EMAIL=support@worklabxc.com
MAIL_ORDER=resend,brevo,mailgun,smtp
RESEND_API_KEY=            # resend.com, free 3,000/month
BREVO_API_KEY=             # brevo.com, free 300/day
MAILGUN_API_KEY=
MAILGUN_DOMAIN=            # e.g. mg.worklabxc.com
MAILGUN_REGION=us          # or eu
SMTP_URL=                  # smtps://user:pass@smtp.zoho.in:465 (Zoho, Gmail, your host)
ADMIN_EMAILS=worklab.xc@gmail.com     # comma-separated; these accounts can open /app/admin

# ---------------------------------------------------------------------------------
# Support (WhatsApp) and automation (n8n)
# ---------------------------------------------------------------------------------
WHATSAPP_SUPPORT_NUMBER=   # digits only with country code, e.g. 919876543210 → wa.me link
WHATSAPP_TOKEN=            # optional: WhatsApp Cloud API alert to your ops number
WHATSAPP_PHONE_ID=
WHATSAPP_OPS_TO=
N8N_WEBHOOK_URL=           # n8n Webhook node URL that receives our events
N8N_SHARED_SECRET=         # same secret in n8n; used to sign events and to authenticate calls back to us

# ---------------------------------------------------------------------------------
# Optional protection (Cloudflare Turnstile). Enable only after adding the widget to the sign-in forms.
# ---------------------------------------------------------------------------------
TURNSTILE_SECRET=
MAX_UPLOAD_BYTES=8388608

# ---------------------------------------------------------------------------------
# Abuse control, consent and VPN checks
# ---------------------------------------------------------------------------------
REQUIRE_CONSENT=1
SIGNUPS_PER_IP_DAY=5              # accounts one address can create per day
AUTO_BLOCK_HITS_PER_HOUR=20       # limit errors in an hour before a temporary block (15 min, then 1 h, then 24 h)
VPN_POLICY=generation          # off | generation (AI features only, default) | all (sign-up and sign-in too)
IPINTEL_PROVIDER=ipapi            # ipapi (default, works without a key at low volume) | ipqs | proxycheck | none
IPINTEL_KEY=
IPINTEL_FAIL=open                 # open = allow when the lookup fails; closed = refuse
IPINTEL_CACHE_HOURS=24
IP_ALLOWLIST=                     # comma list, e.g. 203.0.113.*  (schools, offices)
VPN_PAID_EXEMPT=1                 # paid accounts may use a VPN

# ---------------------------------------------------------------------------------
# Add-ons (rupees) and chat limits
# ---------------------------------------------------------------------------------
PRICE_ADDON_UNIT_NOTES_INR=29
PRICE_ADDON_MONTHLY_NOTES_INR=99
PRICE_ADDON_CHATBOT_MONTH_INR=59
PRICE_ADDON_PACK_MONTH_INR=129
PRICE_ADDON_PODCAST_MONTH_INR=49
ADDON_MONTHLY_NOTES_UNITS=1000000
FREE_CHAT_PER_MONTH=2
FREE_NOTES_PER_MONTH=2
FREE_PODCAST_PER_MONTH=2
PODCASTS_PER_DAY=30
CHAT_MESSAGES_PER_DAY=40

